# Frontend SPA environment configuration
# Copy to .env and adjust values for your environment.

# Base URL for REST API used by the frontend (required)
REACT_APP_API_BASE_URL=http://localhost:4000

# Optional WebSocket base URL for real-time features
REACT_APP_WS_BASE_URL=ws://localhost:4001

# Optional OAuth Client IDs (e.g., Google)
REACT_APP_OAUTH_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Optional Sentry DSN for frontend error tracking
REACT_APP_SENTRY_DSN=

# Feature flags can be JSON or comma-separated key:value
# Examples:
# REACT_APP_FEATURE_FLAGS={"mockMode":false,"lessonsV2":true}
# REACT_APP_FEATURE_FLAGS=mockMode:false,lessonsV2:on
REACT_APP_FEATURE_FLAGS=

# Build/version string shown in diagnostics
REACT_APP_BUILD_VERSION=0.1.0

# Enable MSW mock backend for local development (preferred toggle)
# When true in development, src/index.js will start the mock service worker
REACT_APP_USE_MOCKS=true

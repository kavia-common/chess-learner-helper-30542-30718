# Frontend SPA environment variables (copy to .env and set values)
# Note: Do not commit real secrets. These are placeholders for local/dev.

# Base URL for the backend REST API (e.g., https://api.example.com or http://localhost:8000)
REACT_APP_API_BASE_URL=

# Base URL for WebSocket connections (e.g., wss://ws.example.com or ws://localhost:8000)
REACT_APP_WS_BASE_URL=

# OAuth Client ID for Google login (from Google Cloud Console)
REACT_APP_OAUTH_GOOGLE_CLIENT_ID=

# Sentry DSN for error tracking (optional)
REACT_APP_SENTRY_DSN=

# Feature flags as JSON or comma-separated key:value pairs (e.g., {"newNavbar":true} or newNavbar:true,abExp:on)
REACT_APP_FEATURE_FLAGS=

# Build/version identifier for traceability
REACT_APP_BUILD_VERSION=0.1.0

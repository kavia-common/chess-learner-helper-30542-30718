# Frontend .env example
# Copy to .env and adjust for your environment

# REST API base URL (Express backend)
REACT_APP_API_BASE_URL=http://localhost:4000

# WebSocket base URL (ws or wss)
REACT_APP_WS_URL=ws://localhost:4000

# Google OAuth client id (optional for future frontend usage)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id

# Feature toggles
REACT_APP_FEATURE_MULTIPLAYER=true
REACT_APP_FEATURE_AI=true

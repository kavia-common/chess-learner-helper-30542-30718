# Backend .env example
# Copy to .env and adjust values for local development

# Server
PORT=4000
APP_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess_helper?schema=public

# JWT
JWT_SECRET=dev_jwt_secret_change_me
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_me

# SMTP (optional; if not configured, emails are logged)
EMAIL_FROM=no-reply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

# Storage (local or s3). Local writes to ./uploads and serves via /static
STORAGE_DRIVER=local

# S3 settings (only if STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=chess-avatars
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Features
FEATURE_MULTIPLAYER=true

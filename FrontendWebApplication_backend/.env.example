# Server
PORT=4000
APP_BASE_URL=http://localhost:4000
WEBSOCKET_URL=ws://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chessdb?schema=public

# JWT
JWT_SECRET=replace_me_dev
JWT_REFRESH_SECRET=replace_me_dev_refresh

# SMTP (stub-friendly; set to log-only if host omitted)
EMAIL_FROM="Chess Learner <no-reply@chesslearn.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Must match your deployed callback at `${APP_BASE_URL}/auth/oauth/google/callback`
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

# Storage (S3-compatible; leave empty to use local ./uploads)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=chess-avatars
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Feature flags
FEATURE_MULTIPLAYER=true
FEATURE_AI=true
